        "command"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "motorlab_execute",
    "description": "Comando de motor, saída, script ou %CLMOD existente, por tempo limitado; lê RWD, habilita movimento e ao fim aplica !EX e verifica ?FF. ACK não prova movimento/calibração concluída. Não repete comandos para manter watchdog. release=true envia !MG explicitamente. Requer autorização humana específica para hardware.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "maxLength": 4096
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 50,
          "maximum": 60000
