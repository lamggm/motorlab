  {
    "name": "motorlab_read_parameters",
    "description": "Inicia leitura sequencial; queries omitidas leem todo o catálogo. Retorna job_id; acompanhar com job. Não grava. Recusa sobrescrever rascunhos sem discard_drafts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
