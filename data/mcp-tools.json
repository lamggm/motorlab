        "expected_firmware": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "command",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
