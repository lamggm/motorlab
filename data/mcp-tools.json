  {
    "name": "motorlab_stage",
    "description": "Editar rascunhos locais atomicamente, sem transmitir. query usa ~ALIM 1; raw usa unidade inteira do protocolo. Valida índice, enumeração e escala.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 4096
              },
              "raw": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 4294967295
              }
            },
            "required": [
              "query",
              "raw"
            ],
            "additionalProperties": false
          },
          "maxItems": 700
        }
      },
      "required": [
        "changes"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "motorlab_apply",
    "description": "Aplicar rascunhos lidos na RAM. Tenta pausar script; confirma !EX por ?FF e script/setup inativos por ?FS antes de escrever. Rejeição de !R 0 só é tolerada após essas confirmações. Cada escrita é relida. Não grava EEPROM. Em hardware exige confirm=true e identidade exata, somente após autorização humana para estes valores.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "confirm": {
          "type": "boolean"
        },
        "expected_model": {
          "type": "string",
          "maxLength": 4096
        },
        "expected_firmware": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "motorlab_maintenance",
    "description": "Manutenção documentada (EEPROM, reset, proteção, contadores, salvar calibração). Confirma !EX antes. EESAV tolera pausa de script rejeitada somente com !EX aceito, ?FF confirmando parada e ?FS recente sem script/setup ativos. Outras operações exigem pausa aceita. Não permite upload ou calibração motora por este caminho. Exige autorização humana específica para hardware.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "maxLength": 4096
        },
        "confirm": {
          "type": "boolean"
        },
